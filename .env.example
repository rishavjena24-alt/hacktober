# PromiseLedger — Open-Weight Model Configuration (Owner: Rishav)
# Copy this file to .env and fill in your key. Never commit real secrets.

# Open-weight model API key (Hugging Face token, Groq key, or OpenRouter key)
OPEN_WEIGHT_API_KEY=

# OpenAI-compatible chat completions endpoint URL
OPEN_WEIGHT_API_URL=https://router.huggingface.co/v1/chat/completions

# Open-weight model identifier (Llama 3.3 Community License or Apache-2.0)
OPEN_WEIGHT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Set to true if running a local Ollama server at http://localhost:11434
USE_LOCAL_OLLAMA=false

# Request timeout in seconds before switching to deterministic fallback
EXTRACTOR_TIMEOUT_SEC=8.0

# Set to true to bypass network calls and always use deterministic fallback
EXTRACTOR_FORCE_FALLBACK=false
